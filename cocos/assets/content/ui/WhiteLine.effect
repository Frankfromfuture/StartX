CCEffect %{
  techniques:
  - passes:
    - vert: white-line-vs:vert
      frag: white-line-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState: { cullMode: none }
      properties:
        lineMode: { value: [0, 0, 0, 0] }
}%
CCProgram white-line-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv0 = a_texCoord; color = a_color;
    return cc_matViewProj * position;
  }
}%
CCProgram white-line-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform LineMode { vec4 lineMode; };
  vec4 frag () {
    vec4 art = texture(cc_spriteTexture, uv0);
    float lightness = max(art.r, max(art.g, art.b));
    float ink = mix(1.0 - smoothstep(0.08, 0.32, lightness), smoothstep(0.86, 0.94, lightness), step(0.5, lineMode.x));
    return vec4(color.rgb, art.a * ink * color.a);
  }
}%
