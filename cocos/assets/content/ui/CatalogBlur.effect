CCEffect %{
  techniques:
  - passes:
    - vert: catalog-vs:vert
      frag: catalog-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState: { cullMode: none }
      properties:
        blurStep: { value: [0.005, 0.005, 0.94, 0.42] }
}%
CCProgram catalog-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv0 = a_texCoord; color = a_color;
    return cc_matViewProj * position;
  }
}%
CCProgram catalog-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform Blur { vec4 blurStep; };
  vec4 frag () {
    vec3 blurred = vec3(0.0);
    // Separable binomial weights form a 5x5 Gaussian kernel in one UI pass.
    for (int x = -2; x <= 2; x++) {
      for (int y = -2; y <= 2; y++) {
        float wx = x == 0 ? 6.0 : ((x == 1 || x == -1) ? 4.0 : 1.0);
        float wy = y == 0 ? 6.0 : ((y == 1 || y == -1) ? 4.0 : 1.0);
        blurred += texture(cc_spriteTexture, clamp(uv0 + vec2(float(x), float(y)) * blurStep.xy, vec2(0.0), vec2(1.0))).rgb * wx * wy;
      }
    }
    return vec4(mix(blurred / 256.0, vec3(0.10, 0.12, 0.15), blurStep.w), blurStep.z) * color;
  }
}%
